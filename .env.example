# Variables de entorno para producción
# Copia este archivo como .env y completa los valores

# Dominio y servidor
DOMAIN_NAME=tudominio.com
SERVER_IP=123.456.789.123

# Base de datos
DB_PASSWORD=tu_password_super_seguro_aqui

# Django
SECRET_KEY=tu_secret_key_super_largo_y_seguro_aqui
DEBUG=False

# Email para certificados SSL
EMAIL=tu@email.com

# Opcional: Configuración de email para Django
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu@gmail.com
EMAIL_HOST_PASSWORD=tu_password_de_app

# Credenciales de aplicación (opcional, para scripts de bootstrap)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=tu_password_superuser
# APP_ADMIN_USERNAME=operaciones_admin
# APP_ADMIN_PASSWORD=tu_password_admin
# VPS_SSH_PASSWORD=tu_password_vps

# Backup/restore (opcional)
# COMPOSE_FILE=docker-compose.prod.yml
# ENV_FILE=.env.prod
# DB_SERVICE=db
# DB_SPECS="ecodisseny_db:ecodisseny"
# GDRIVE_REMOTE=gdrive:ecodisseny-backups/database
